# Salin ke .env lalu isi dari Supabase:
#   Dashboard > Project > tombol "Connect" > Connection string > "Transaction pooler"
# Ganti [YOUR-PASSWORD] dengan password database. Jika password mengandung
# karakter khusus (@ : / # ? %), ubah dulu ke format URL-encoded (contoh @ -> %40).
# Format 'postgresql://...' dari Supabase diterima; aplikasi mengubahnya otomatis.
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Opsional: zona waktu untuk "hari ini" (default Asia/Jakarta)
APP_TIMEZONE=Asia/Jakarta
