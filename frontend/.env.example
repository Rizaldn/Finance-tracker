# Alamat backend yang dipanggil oleh browser.
# KOSONGKAN (disarankan): browser memanggil /api/v1 pada origin yang sama, lalu
# Vite (dev/preview) atau vercel.json (produksi) meneruskannya ke backend.
# Cara ini tidak membutuhkan CORS di backend.
#
# Isi dengan URL penuh hanya jika backend sudah mengirim header CORS untuk
# origin frontend ini, misalnya:
# VITE_API_BASE_URL=https://finance-tracker-rizall.vercel.app
VITE_API_BASE_URL=

# Target proxy untuk `npm run dev` dan `npm run preview` (tidak dibaca browser).
API_PROXY_TARGET=https://finance-tracker-rizall.vercel.app

# ID pengguna demo awal. Bisa diganti dari aplikasi (menu pengguna di header).
VITE_DEMO_USER_ID=16
