
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://finance-tracker-nu-murex-64.vercel.app/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://finance-tracker-nu-murex-64.vercel.app/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://finance-tracker-nu-murex-64.vercel.app/openapi.json"
    },
    {
      "source": "/redoc",
      "destination": "https://finance-tracker-nu-murex-64.vercel.app/redoc"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
